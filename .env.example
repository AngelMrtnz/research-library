# Only this Google account can sign in.
OWNER_EMAIL=you@gmail.com
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application).
# Authorized redirect URI: https://<your-host>/auth/callback (and http://localhost:8000/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# gdrive = use the Drive API (hosted). local = a folder on disk, e.g. your
# Google Drive for Desktop folder when running on your own PC.
STORAGE=gdrive
# The folder ID is the last part of the folder's Drive URL.
DRIVE_LIBRARY_FOLDER_ID=
DRIVE_INBOX_FOLDER_ID=
# For STORAGE=local:
# LOCAL_LIBRARY_DIR=G:/My Drive/Papers
# LOCAL_INBOX_DIR=G:/My Drive/Papers/Inbox

# https://aistudio.google.com/apikey  (leave empty to use the no-AI fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local development only: skip sign-in.
# AUTH_DISABLED=1
