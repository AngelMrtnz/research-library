# Running on your own PC: the app is only reachable from this computer, so no login.
AUTH_DISABLED=1
STORAGE=local
# Your Google Drive for Desktop folder. Renames here sync to Drive.
LOCAL_LIBRARY_DIR=G:/My Drive/Papers
LOCAL_INBOX_DIR=G:/My Drive/Papers/Inbox
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
