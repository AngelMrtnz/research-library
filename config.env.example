# Running on your own PC: the app is only reachable from this computer, so no login.
AUTH_DISABLED=1
STORAGE=local
# Your Google Drive for Desktop folder (mirror mode, e.g. C:/Users/you/My Drive, or
# "Mi unidad" in Spanish; in stream mode it is G:/My Drive). Renames here sync to Drive.
LOCAL_LIBRARY_DIR=C:/Users/you/Mi unidad/Papers
LOCAL_INBOX_DIR=C:/Users/you/Mi unidad/Papers/Inbox
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
